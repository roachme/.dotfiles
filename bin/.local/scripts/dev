#!/bin/env bash

COMMAND="$1"

function dev_check()
{
    echo "check list of utils are used are installed"
}

function dev_install()
{
    echo "install list of utils are used are installed"
}

function dev_switch()
{
    local mode="$1"

    if [ "$mode" = "--help" ] || [ "$mode" = "help" ] || [ "$mode" = "-h" ]; then
        echo "Usage: $PROGRAM switch [4k]"
    elif [ "$mode" = "4k" ] || [ "$mode" = "4K" ]; then
        echo "> set up 4K mode"
        xrandr --output HDMI-1 --mode 3840x2160 --rate 60
    else
        echo "> get back to normal mode"
        xrandr --output HDMI-1 --mode 2560x1440 --rate 120
    fi
}


function dev_help()
{
    cat << EOF
Usage: dev devname [OPTION]... [COMMAND]

    Commands:
      one       - one monitor (switch to external if available)
      two       - two monitors (enable main and external if available)
      main      - turn off external monitors, enable laptop monitor only
      help      - show this help message and exit
      mon       - setup monitors
      sound     - setup speaker (and mic)
EOF
}

function dev_one()
{
    if xrandr | grep -qw "^HDMI-1 connected"; then
        echo "> one monitor: switching to external (HDMI-1)"
        xrandr --output HDMI-1 --auto --primary
        xrandr --output eDP-1 --off
    else
        echo "> one monitor: external not connected, using main (eDP-1)"
        xrandr --output eDP-1 --auto --primary
    fi
}

function dev_two()
{
    if ! xrandr | grep -qw "^HDMI-1 connected"; then
        echo "> two monitors: external (HDMI-1) not connected"
        return 1
    fi

    echo "> two monitors: enabling main (eDP-1) and external (HDMI-1)"
    xrandr --output eDP-1 --auto --primary
    xrandr --output HDMI-1 --auto --right-of eDP-1
}

function dev_main()
{
    xrandr --output eDP-1 --auto --primary

    while read -r out; do
        [ "$out" = "eDP-1" ] && continue
        xrandr --output "$out" --off
    done < <(xrandr | grep -w connected | awk '{print $1}')
}

function dev_mon()
{
    MOMITOR_COUNT="$(xrandr | grep -wc connected)"

    if [ "$MOMITOR_COUNT" -eq 2 ]; then
        echo "Switch to external monitor"
        xrandr --output HDMI-1 --auto # turn it on just in case
        xrandr --output HDMI-1 --primary
        xrandr --output eDP-1 --off
    else
        echo "Switch back to main monitor"
        xrandr --output HDMI-1 --off
        xrandr --output eDP-1 --auto
    fi
}

function dev_speaker()
{
    echo "WARNING: Find yer speaker first. Then use command below"
    pactl set-default-sink alsa_output.usb-Logitech_Logi_USB_Headset_000000000000-00.analog-stereo
}

function dev_sync()
{
    rsync -rP work:~/share/ $HOME/share
}

if [ -z "$COMMAND" ]; then
    dev_main "$@"
elif [ "$COMMAND" = "one" ]; then
    dev_one "$@"
elif [ "$COMMAND" = "two" ]; then
    dev_two "$@"
elif [ "$COMMAND" = "main" ]; then
    dev_main "$@"
elif [ "$COMMAND" = "help" ]; then
    dev_help "$@"
elif [ "$COMMAND" = "sync" ]; then
    dev_sync "$@"
elif [ "$COMMAND" = "switch" ]; then
    shift 1
    dev_switch "$@"
fi

#!/bin/env bash

PROGRAM="vpn"

die() {
    echo "$PROGRAM: ""$@" >&2
    exit 1
}

_config_exist() {
    local cfg="$1"
}

vpn_help() {
    cat << EOF
Usage: vpn COMMAND

    Commands:
      help      show this help message and exit
      ls        list openvpn instances and configs
      start     start openvpn instance
      stop      stop openvpn instance
      switch    stop running VPNs and start specified one
EOF
}

vpn_ls() {
    #echo "List running openvpn instances"
    #sudo systemctl --type=service  | grep openvpn

    #echo
    echo "List available configs"
    #ls /etc/openvpn/client/*.conf | tr -s ' ' | tr ' ' '\n'
    sudo ls /etc/wireguard/
}

vpn_start() {
    local cfg="$1"

    if [ -z "$cfg" ]; then
        cfg="Lithuania"
    fi

    #_config_exist "$cfg"
    sudo wg-quick up "$cfg"
}

vpn_stop() {
    local cfg="$1"

    if [ -z "$cfg" ]; then
        cfg="Lithuania"
    fi

    #_config_exist "$cfg"
    sudo wg-quick down "$cfg"
}

vpn_switch() {
    return 0;
}

vpn() {
    local cmd=
    [ $# -eq 0 ] && set -- "ls"; cmd="$1"
    case "$cmd" in
        ls)          shift; vpn_ls "$@" ;;
        help)        shift; vpn_help "$@" ;;
        start)       shift; vpn_start "$@" ;;
        stop)        shift; vpn_stop "$@" ;;
        switch)      shift; vpn_switch "$@" ;;
        *)           die "'$cmd': no such vpn command"
    esac
}
vpn "$@"

#!/bin/env bash

PROGRAM="vpn"

die() {
    echo "$PROGRAM: ""$@" >&2
    exit 1
}

_config_exist() {
    local cfg="$1"
    local base="/etc/amnezia/amneziawg"

    sudo test -f "${base}/${cfg}.conf"
}

vpn_help() {
    cat << EOF
Usage: vpn COMMAND

    Commands:
      fix       NetworkManager DNS hotfix
      help      show this help message and exit
      ls        list openvpn instances and configs
      ping      Ping to check internet connection
      ps        Show all running VPNs
      restart   Restart VPN service
      start     start openvpn instance
      status    Show VPN status
      stop      stop openvpn instance
      switch    stop running VPNs and start specified one
EOF
}

vpn_fix() {
    sudo cp /etc/resolv.conf.bak /etc/resolv.conf
    sudo systemctl restart NetworkManager
}

vpn_ping() {
    local hostname="$1"

    if [ -z "$hostname" ]; then
        hostname="ya.ru"
    fi
    ping "$hostname"
}

vpn_status() {
    local cfg="$1"

    if [ -z "$cfg" ]; then
        cfg="awg0"
    fi
    sudo systemctl status "awg-quick@${cfg}"
}

vpn_ls() {
    echo "List available configs"
    for cfg in $(sudo ls /etc/amnezia/amneziawg); do
        if [[ "$cfg" == *.conf ]]; then
            echo "  ${cfg%.conf}"
        fi
    done
}

vpn_start() {
    local cfg="$1"

    if [ -z "$cfg" ]; then
        cfg="awg0"
    fi

    if ! _config_exist "$cfg"; then
        echo "${cfg}: no such config" >&2
        exit 1
    fi

    #sudo wg-quick up "$cfg"
    sudo systemctl start "awg-quick@${cfg}"
}

vpn_stop() {
    local cfg="$1"

    if [ -z "$cfg" ]; then
        cfg="awg0"
    fi

    if ! _config_exist "$cfg"; then
        echo "${cfg}: no such config" >&2
        exit 1
    fi

    #sudo wg-quick down "$cfg"
    sudo systemctl stop "awg-quick@${cfg}"
}

vpn_restart() {
    sudo systemctl restart awg-quick@awg0
}

vpn_switch() {
    return 0;
}

vpn_ps() {
    sudo systemctl | grep -F 'awg-quick@' | tr -s ' ' | cut -f 2,3 -d ' '
}

vpn() {
    local cmd=
    [ $# -eq 0 ] && set -- "ls"; cmd="$1"
    case "$cmd" in
        ls)          shift; vpn_ls "$@" ;;
        help)        shift; vpn_help "$@" ;;
        fix)         shift; vpn_fix "$@" ;;
        ping)        shift; vpn_ping "$@" ;;
        ps)          shift; vpn_ps "$@" ;;
        status)      shift; vpn_status "$@" ;;
        start)       shift; vpn_start "$@" ;;
        stop)        shift; vpn_stop "$@" ;;
        restart)     shift; vpn_restart "$@" ;;
        switch)      shift; vpn_switch "$@" ;;
        *)           die "'$cmd': no such vpn command"
    esac
}
vpn "$@"
